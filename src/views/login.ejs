<%- include('partials/head', { pageTitle: 'Iniciar sesión' }) %>
<%- include('partials/header', { activo: 'login' }) %>
    <main id="contenido" tabindex="-1" class="contenido contenido-estrecho">
      <h1>Iniciar sesión</h1>

      <% if (registrado) { %>
        <p class="aviso aviso-ok" role="status">Cuenta creada correctamente. Ya puedes iniciar sesión.</p>
      <% } %>

      <% if (error) { %>
        <p class="aviso aviso-error" role="alert"><%= error %></p>
      <% } %>

      <form method="post" action="/login" class="formulario">
        <div class="campo">
          <label for="email">Correo electrónico</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="username"
            maxlength="254"
            required
          />
        </div>

        <div class="campo">
          <label for="password">Contraseña</label>
          <input
            id="password"
            name="password"
            type="password"
            autocomplete="current-password"
            required
          />
        </div>

        <button type="submit" class="boton boton-primario">Entrar</button>
      </form>

      <p class="alterno">¿Sin cuenta? <a href="/registro">Crear una cuenta</a></p>
    </main>
<%- include('partials/footer') %>
