# Copia de referencia. Para generar .env con secretos aleatorios: npm run setup:env

# Entorno de ejecución: development, test o production
NODE_ENV=development
# Puerto HTTP en el que escucha la aplicación
PORT=3000
# Origen público de la aplicación (esquema, host y puerto, sin ruta)
APP_ORIGIN=http://localhost:3000
# Conexión de la aplicación con el rol restringido login_log_app
DATABASE_URL=postgres://login_log_app:CAMBIAR_PASSWORD_APP@localhost:5432/login_log
# Conexión privilegiada usada solo por las migraciones
MIGRATION_DATABASE_URL=postgres://postgres@localhost:5432/login_log
# Como DATABASE_URL pero contra la base de pruebas (misma contraseña del rol)
TEST_DATABASE_URL=postgres://login_log_app:CAMBIAR_PASSWORD_APP@localhost:5432/login_log_test
# Como MIGRATION_DATABASE_URL pero contra la base de pruebas
TEST_MIGRATION_DATABASE_URL=postgres://postgres@localhost:5432/login_log_test
# Clave HMAC para seudonimizar identificadores en el log de auditoría (mínimo 32 caracteres)
AUDIT_HMAC_KEY=CAMBIAR_CLAVE_HMAC_DE_AL_MENOS_32_CARACTERES

# Opcionales, con su valor por defecto:
# Nombre del servicio que figura en cada evento de auditoría
# SERVICE_NAME=login-log
# Directorio de los archivos de log (en modo test se usa su subdirectorio test)
# LOG_DIR=logs
# Días que se conservan los archivos de log rotados
# LOG_RETENTION_DAYS=90
# Tamaño máximo de cada archivo de log antes de rotar (k, m o g)
# LOG_MAX_FILE_SIZE=20m
# Saltos de proxy inverso en los que se confía para obtener la IP del cliente; 0 = ninguno
# TRUST_PROXY=0
# Minutos de inactividad tras los que expira una sesión
# SESSION_IDLE_MINUTES=30
# Horas de vida máxima de una sesión aunque haya actividad
# SESSION_ABSOLUTE_HOURS=8
# Intentos fallidos consecutivos que bloquean la cuenta
# LOCKOUT_THRESHOLD=5
# Minutos que dura el bloqueo de la cuenta
# LOCKOUT_MINUTES=15
# Intentos de login permitidos por IP dentro de la ventana
# IP_RATE_LIMIT_MAX=20
# Duración en minutos de la ventana del límite por IP
# IP_RATE_LIMIT_WINDOW_MINUTES=15
# Solicitudes HTTP permitidas por IP dentro de la ventana general
# HTTP_RATE_LIMIT_MAX=120
# Duración en segundos de la ventana del límite general de solicitudes por IP
# HTTP_RATE_LIMIT_WINDOW_SECONDS=60
